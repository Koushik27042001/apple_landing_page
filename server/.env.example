# ============================================================
# Iswift Gadgets Server Environment Configuration Example
# Copy this file to ".env" and fill in your real values.
# ============================================================

# Server Port
PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4000,http://127.0.0.1:4000

# ------------------------------------------------------------
# MongoDB Database Connection URL
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://shahnawaz_db_user:mj2AwFwk86MiMx2v@cluster0.5kpzo2e.mongodb.net/apple_store_database?appName=Cluster0

# Admin Panel Password (default: admin123)
# Access the admin control panel at http://localhost:4000/admin/
ADMIN_PASSWORD=admin123

# Razorpay Payment Gateway Keys (https://dashboard.razorpay.com/app/keys)
# Optional: fill in to enable live automated Razorpay checkout popup
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Customer-facing Payment Page (UPI QR / Pay Link) — works without API keys
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@iswiftgadgetsprivatelimit3022

# Razorpay Webhook Secret (Set same value in Razorpay Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Currency (INR for Indian Rupee)
CURRENCY=INR
