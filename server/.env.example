# Local backend and frontend: npm start, then http://localhost:4000
NODE_ENV=development
PORT=4000
ADMIN_PASSWORD=
# Blank uses local JSON storage. Set your own MongoDB URI to use MongoDB.
MONGODB_URI=
# Blank uses server/data and client/images/uploads locally.
# Production requires absolute paths on a persistent disk.
DATA_DIR=
UPLOAD_DIR=
# Blank is sufficient when frontend and backend share an origin.
CORS_ORIGIN=
CURRENCY=INR
# Configure Razorpay Checkout to enable online payment. COD is available without keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cloudinary Storage for Production Image Uploads
CLOUDINARY_URL=cloudinary://133769216652831:_2FG-c9MPQR9CfxfbVtnmgkunHw@m3kbkm9p
