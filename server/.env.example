# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to source control.

# Server
PORT=4000
# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080

# Razorpay (https://dashboard.razorpay.com/app/keys)
# Use your TEST keys first (they start with rzp_test_). Switch to LIVE keys
# (rzp_live_) only after your KYC is approved and you are ready to go live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Webhook secret — set the SAME value here and in the Razorpay Dashboard
# under Settings > Webhooks when you register the webhook URL
# (https://yourdomain.com/api/payments/webhook).
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Store currency (Razorpay expects the smallest unit, i.e. paise, for INR)
CURRENCY=INR
