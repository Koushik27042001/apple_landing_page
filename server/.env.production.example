# Local backend and frontend: npm start, then http://localhost:4000
NODE_ENV=production
PORT=10000
ADMIN_PASSWORD=
# Blank uses local JSON storage. Set your own MongoDB URI to use MongoDB.
MONGODB_URI=
# Blank uses server/data and client/images/uploads locally.
# Production requires absolute paths on a persistent disk.
DATA_DIR=/var/data/store
UPLOAD_DIR=/var/data/uploads
# Blank is sufficient when frontend and backend share an origin.
CORS_ORIGIN=
CURRENCY=INR
RAZORPAY_PAYMENT_LINK=https://razorpay.me/@iswiftgadgetsprivatelimit3022
# Optional for API-based Razorpay checkout, not needed for payment links or COD.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
