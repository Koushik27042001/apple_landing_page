{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "client",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://apple-landing-page-eut1.onrender.com/api/:path*"
    },
    {
      "source": "/images/uploads/:path*",
      "destination": "https://apple-landing-page-eut1.onrender.com/images/uploads/:path*"
    }
  ]
}
